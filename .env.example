# Supabase > Project Settings > API
# Use the anon (public) key only. NEVER put the service-role key in frontend code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Worker URL: file manager and user management (see README > Cloudflare Worker)
VITE_API_URL=https://awenue-files-api.your-subdomain.workers.dev

# Main Website Base URL (Server-side proxy only; never prefix with VITE_)
AWENUE_WEBSITE_API_URL="https://www.awenueglobalsoftwaresolutions.in"

# Main Website Endpoints (Leads & Contact Queries)
AWENUE_CRM_SYNC_ENDPOINT="https://www.awenueglobalsoftwaresolutions.in/api/crm/sync"
AWENUE_PROJECT_ENQUIRIES_ENDPOINT="https://www.awenueglobalsoftwaresolutions.in/api/project-enquiries"
AWENUE_CONTACT_MESSAGES_ENDPOINT="https://www.awenueglobalsoftwaresolutions.in/api/contact-messages"

# Authentication Key (Same as ADMIN_API_KEY in Main Website .env; server-side only)
AWENUE_WEBSITE_API_KEY="your-website-admin-api-key"

# Resend Email Automation & Mailing System (Server-side / Cloudflare Worker / Railway only)
# NEVER prefix with VITE_ or expose to client bundles.
RESEND_API_KEY=""
RESEND_SUPPORT_FROM="AWENUE Support Team <support@awenueglobalsoftwaresolutions.in>"
RESEND_BILLING_FROM="AWENUE Billing Department <billing@awenueglobalsoftwaresolutions.in>"
RESEND_SUPPORT_REPLY_TO="support@awenueglobalsoftwaresolutions.in"
RESEND_BILLING_REPLY_TO="billing@awenueglobalsoftwaresolutions.in"
RESEND_WEBHOOK_SECRET=""
APP_BASE_URL="https://www.awenueglobalsoftwaresolutions.in"
